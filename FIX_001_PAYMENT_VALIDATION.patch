# GOR Booking - FIX #001: SERVER-SIDE PAYMENT AMOUNT VALIDATION
# 
# CRITICAL SECURITY FIX
# Issue: Client can modify payment amount before submission
# Risk: 🔴 CRITICAL - Revenue loss, fraud
# Effort: 2 hours
# Status: READY TO APPLY
#
# What this fixes:
# - Prevents client from changing booking price
# - Recalculates amount server-side from court price + duration
# - Rejects mismatched amounts
# - Logs validation errors for fraud detection
#
# =============================================================================

# FILE 1: Add validation function
# Path: backend/gor-api/src/lib/validations.ts (ADD FUNCTION)

cat >> /vercel/share/v0-project/backend/gor-api/src/lib/validations.ts << 'EOF'

/**
 * Validate booking amount matches server calculation
 * 
 * Flow:
 * 1. Fetch booking from DB (courtId, startTime, endTime, bookingDate)
 * 2. Fetch court (pricePerHour)
 * 3. Calculate: hours = parseInt(endTime) - parseInt(startTime)
 * 4. Expected: hours * pricePerHour
 * 5. Compare: incomingAmount === expectedAmount
 * 
 * @param bookingId - Booking ID to validate
 * @param incomingAmount - Amount sent by client (in cents)
 * @returns { valid: boolean, expectedAmount?: number, error?: string }
 */
export async function validateBookingAmount(
  bookingId: string,
  incomingAmount: number
): Promise<{ valid: boolean; expectedAmount?: number; error?: string }> {
  try {
    // 1. Fetch booking with court info
    const booking = await prisma.booking.findUnique({
      where: { id: bookingId },
      include: { court: true },
    });

    if (!booking) {
      return { valid: false, error: 'Booking not found' };
    }

    if (!booking.court) {
      return { valid: false, error: 'Court not found for booking' };
    }

    // 2. Parse time strings (format: "14" for 2 PM, "15" for 3 PM)
    const startHour = parseInt(booking.startTime, 10);
    const endHour = parseInt(booking.endTime, 10);

    if (isNaN(startHour) || isNaN(endHour)) {
      return { valid: false, error: 'Invalid booking time format' };
    }

    if (startHour < 0 || startHour > 24 || endHour < 0 || endHour > 24) {
      return { valid: false, error: 'Time out of valid range (0-24)' };
    }

    if (endHour <= startHour) {
      return { valid: false, error: 'End time must be after start time' };
    }

    // 3. Calculate expected amount
    const durationHours = endHour - startHour;
    const expectedAmount = durationHours * booking.court.pricePerHour;

    // 4. Compare
    if (incomingAmount !== expectedAmount) {
      return {
        valid: false,
        expectedAmount,
        error: `Amount mismatch: expected ${expectedAmount}, got ${incomingAmount}`,
      };
    }

    return { valid: true, expectedAmount };
  } catch (error) {
    return {
      valid: false,
      error: error instanceof Error ? error.message : 'Unknown error',
    };
  }
}
EOF

