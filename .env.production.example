# ── Production Environment Variables ──
# Copy to .env.production and fill in real values

# Database (Railway auto-generates DATABASE_URL, or use your own)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gor

# JWT (generate: openssl rand -hex 32)
JWT_SECRET=

# Backend port
PORT=4000

# CORS — your frontend domain
CORS_ORIGIN=https://your-frontend.up.railway.app

# Midtrans (production keys from midtrans dashboard)
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true

# Frontend env vars (used during build)
VITE_API_URL=/api/v1
VITE_SOCKET_URL=wss://your-backend.up.railway.app